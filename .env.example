# anyrag configuration. Copy to .env and fill in.
# NEVER commit .env -- it is gitignored.

# ---------------------------------------------------------------------------
# Source selection
# ---------------------------------------------------------------------------
# URI form: <scheme>:<locator>
#   sqlite:/abs/path/to/database.sqlite
#   postgres:postgresql://user:pass@host:5432/dbname
#   files:/abs/path/to/directory-of-csv-or-parquet
ANYRAG_SOURCE_URI=sqlite:evals/data/synthetic.sqlite

# The Postgres adapter reads its connection string from this variable rather
# than from any committed file. Prefer this over putting credentials in a URI.
ANYRAG_PG_DSN=

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# auto (default) | local | hashing | remote
# "auto" prefers the local sentence-transformers model and falls back to the
# deterministic hashing embedder, recording the fallback reason.
ANYRAG_EMBEDDER=auto

# Force the degraded hashing embedder, e.g. to reproduce a degraded run.
# ANYRAG_FORCE_HASHING_EMBEDDER=1

# Optional remote embedding provider (never used by the offline eval path).
ANYRAG_EMBED_API_KEY=
ANYRAG_EMBED_ENDPOINT=
ANYRAG_EMBED_MODEL=

# ---------------------------------------------------------------------------
# Generation
# ---------------------------------------------------------------------------
# Optional. When set, the eval harness additionally runs the distractor subset
# through the LLM-backed generator and reports both false-answer rates.
# Absence is fine: the offline extractive generator is the default.
ANTHROPIC_API_KEY=
ANYRAG_ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
ANYRAG_INDEX_DIR=.anyrag/index
